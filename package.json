{
  "name": "diagram-plugin",
  "version": "0.20.1",
  "private": true,
  "type": "module",
  "description": "Visual diagram workspace with Mermaid editing, Canvas documents and MCP tools for Codex and DeepSeek Harness.",
  "license": "MIT",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "visual:smoke": "node scripts/visual-smoke.mjs",
    "visual:styles": "node --import tsx scripts/visual-styles.ts",
    "visual:benchmark": "node scripts/visual-smoke.mjs --source-dir tests/fixtures/visual-stress --quality-benchmark",
    "benchmark:architecture": "node --import tsx scripts/benchmark-architecture.ts",
    "benchmark:architecture:review": "node --import tsx scripts/benchmark-architecture.ts --suite=extended --require-review-ready",
    "benchmark:architecture:project": "node --import tsx scripts/benchmark-architecture.ts --suite=project",
    "benchmark:architecture:acceptance": "node --import tsx scripts/benchmark-architecture.ts --suite=project --require-review-ready",
    "benchmark:architecture:project:visual": "node --import tsx scripts/benchmark-architecture-design.ts --project --screenshots",
    "benchmark:architecture:design": "node --import tsx scripts/benchmark-architecture-design.ts",
    "benchmark:architecture:visual:score": "node --import tsx scripts/architecture-visual-score.ts",
    "benchmark:architecture:title-pixels": "node --import tsx scripts/architecture-title-pixels.ts",
    "benchmark:architecture:relation-lens": "node scripts/architecture-relation-focus-smoke.mjs",
    "benchmark:architecture:visual:blind": "node --import tsx scripts/architecture-visual-blind.ts",
    "benchmark:architecture:visual:repeat": "node --import tsx scripts/architecture-visual-repeat.ts",
    "benchmark:architecture:engines": "node --import tsx scripts/benchmark-architecture-engines.ts",
    "benchmark:architecture:d2": "node --import tsx scripts/benchmark-architecture-d2.ts",
    "perf:canvas": "node scripts/benchmark-canvas.mjs",
    "visual:regression": "node scripts/visual-regression.mjs",
    "visual:regression:update": "node scripts/visual-regression.mjs --update",
    "visual:verify": "pnpm visual:smoke && pnpm visual:benchmark && pnpm visual:styles && pnpm visual:regression",
    "plugin:install": "pnpm build && node scripts/install-codex-plugin.mjs",
    "plugin:install:desktop": "pnpm plugin:install && node scripts/reload-codex-desktop.mjs",
    "check:hosts": "node --test tests/integration/*.test.mjs"
  },
  "dependencies": {
    "@codemirror/language": "^6.11.3",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "@lezer/highlight": "^1.2.1",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openai/mcp-extensions": "^0.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "lucide": "^1.54.0",
    "lucide-react": "^1.54.0",
    "mermaid": "^11.12.0",
    "proper-lockfile": "^4.1.2",
    "radix-ui": "^1.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "simple-icons": "^16.34.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "elkjs": "0.12.0",
    "esbuild": "^0.25.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
